# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
DEVLOG.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# database
# 注意：根目录 dev.db 是 CI 每周采集的持久化数据库，必须进 git（否则每周空库重跑、重复烧 token）
prisma/dev.db
prisma/dev.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# claude
.claude/

# workbuddy (Kimi 工作区)
.workbuddy/
HANDOFF.md

# local dev tooling (not for deployment)
/Docker/
